.pair-screen{padding-top:0}.pair-art{text-align:center;height:240rpx}.pair-art image{width:200rpx;height:240rpx}.pair-title{text-align:center;font-family:"Songti SC","Noto Serif CJK SC",STSong,serif;font-size:44rpx;font-weight:600;line-height:1.6;margin:24rpx 0 20rpx}.pair-title text{display:block;color:var(--color-accent)}.pair-subtitle{text-align:center;color:var(--color-secondary);font-size:26rpx;line-height:1.9;margin-bottom:36rpx}.pair-subtitle text{display:block}.pair-form{border-top:4rpx solid var(--color-pink);border-radius:2rpx}.pair-tabs{display:flex;border-bottom:1rpx solid var(--color-line);margin-bottom:32rpx;gap:20rpx}.pair-tabs button{flex:1;min-width:0;font-size:26rpx;color:var(--color-secondary);padding:12rpx 0 20rpx;min-height:44px;border-bottom:3rpx solid transparent}.pair-tabs button.active{color:var(--color-accent);border-bottom-color:var(--color-accent);font-weight:500}.name-choice{margin-bottom:20rpx}.name-choice button{padding:18rpx 32rpx;min-height:44px;font-size:26rpx;border:1rpx solid #CDBCAD;border-radius:var(--radius-sm);color:var(--color-secondary)}.name-choice button.selected{background:var(--color-tint);color:var(--color-accent);border-color:var(--color-accent)}.invite-card{text-align:center;border-radius:2rpx;border-top:4rpx solid var(--color-pink)}.invite-code{font-family:monospace;font-size:54rpx;color:var(--color-accent);letter-spacing:6rpx;margin:28rpx 0;word-break:break-all}.invite-card .primary{margin-top:32rpx}.invite-card .secondary{margin-top:20rpx}.invite-card .link{margin-top:12rpx}.code-input{letter-spacing:6rpx;text-transform:uppercase}.demo-explain .title{font-size:32rpx}.demo-explain .notice{padding:24rpx 0}
.pair-tabs button{width:0}.name-choice button{width:auto}

.pair-form .field{height:auto;min-height:96rpx}.name-choice{gap:16rpx}
.pair-form input.field{min-height:var(--touch-target);height:96rpx}
.pair-tagline{text-align:center;color:var(--color-accent);font-size:24rpx;line-height:1.85;margin:0 0 20rpx;word-break:break-word}.pair-subtitle{max-width:620rpx;margin-left:auto;margin-right:auto;word-break:break-word}
