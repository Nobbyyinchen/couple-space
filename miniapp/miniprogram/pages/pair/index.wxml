<view class="screen pair-screen"><view class="pair-art"><image aria-hidden="true" src="/assets/paper-bloom.png" mode="aspectFit"/></view><view class="pair-title">{{brand.title}}</view><view class="pair-tagline">{{brand.tagline}}</view><view class="pair-subtitle">{{brand.description}}</view>
<view wx:if="{{demo}}" class="card demo-explain"><view class="title">你现在处于本机演示</view><view class="notice">这里模拟了{{names[0]}}和{{names[1]}}的双人空间，可以先体验所有页面。演示邀请码不能连接两台手机，真实同步需要配置 AppID 和云开发环境。</view><button class="primary" bindtap="home">先体验我们的小宇宙</button></view>
<block wx:elif="{{state.space}}"><view wx:if="{{state.space.paired}}" class="card empty"><view class="empty-title">你们已经在同一个小宇宙啦 ♡</view><button class="primary" bindtap="home">回到我们的今天</button></view><view wx:else class="card invite-card"><view class="small muted">把这个邀请码，交给另一半</view><view class="invite-code">{{inviteCode || '········'}}</view><view class="subtle">24 小时内有效 · 仅可使用一次</view><button wx:if="{{!inviteCode}}" class="primary" bindtap="newInvite" loading="{{busy}}">生成新的邀请码</button><block wx:else><button class="primary" bindtap="copy">复制邀请码</button><button class="secondary" open-type="share">由我分享给另一半</button><button class="link" bindtap="newInvite">重新生成（旧码会失效）</button></block><button class="link" bindtap="home">先去记下一个瞬间 →</button></view></block>
<view wx:else class="card pair-form"><view class="pair-tabs"><button class="{{tab === 'create' ? 'active' : ''}}" data-tab="create" bindtap="tab">创建我们的空间</button><button class="{{tab === 'join' ? 'active' : ''}}" data-tab="join" bindtap="tab">加入 TA 的空间</button></view><view class="form-block"><text class="input-label">我是</text><view class="row name-choice"><button wx:for="{{names}}" wx:key="*this" data-name="{{item}}" bindtap="name" class="{{nickname === item ? 'selected' : ''}}">{{item}}</button></view><input placeholder-style="color:#766962" class="field" value="{{nickname}}" data-field="nickname" bindinput="input" maxlength="20" placeholder="你想显示的昵称"/></view><block wx:if="{{tab === 'create'}}"><view class="form-block"><text class="input-label">我们的小宇宙叫</text><input placeholder-style="color:#766962" class="field" value="{{name}}" data-field="name" bindinput="input" maxlength="40"/></view><view class="form-block"><text class="input-label">相恋的第一天</text><picker mode="date" value="{{startDate}}" bindchange="date"><view class="field">{{startDate}}</view></picker></view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="create">创建，再邀请 TA ♡</button></block><block wx:else><view class="form-block"><text class="input-label">另一半给我的邀请码</text><input placeholder-style="color:#766962" class="field code-input" value="{{code}}" data-field="code" bindinput="input" maxlength="8" placeholder="8 位字母和数字"/></view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="join">和 TA 进入同一个小宇宙</button></block></view><view class="bottom-note">一颗小宇，一条小宙。一起游向明天。</view></view>
