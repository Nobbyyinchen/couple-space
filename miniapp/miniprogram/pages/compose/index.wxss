.compose-intro{margin:8rpx 0 32rpx}.compose-intro>.subtle{font-size:22rpx;letter-spacing:2rpx;color:var(--color-accent)}.compose-intro>view:last-child{font-family:"Songti SC","Noto Serif CJK SC",STSong,serif;font-size:38rpx;font-weight:600;margin-top:14rpx;line-height:1.6}.compose-card{border-radius:2rpx;border-top:4rpx solid #D9A0AA;padding:30rpx}.compose-title{font-size:30rpx;font-weight:500;border-bottom:1rpx solid var(--color-line);padding:12rpx 0 24rpx;height:104rpx;min-height:44px}.compose-body{font-size:29rpx;line-height:2;width:100%;min-height:360rpx;padding-top:28rpx}.character-count{text-align:right;color:var(--color-secondary);font-size:22rpx;margin:16rpx 0 28rpx}.compose-photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.photo-cell,.photo-add{height:180rpx;position:relative}.photo-cell image{width:100%;height:100%;border-radius:4rpx}.remove-photo{position:absolute;top:0;right:0;width:44px;height:44px;display:flex;align-items:center;justify-content:center;background:transparent;color:#FFFDF9;font-size:32rpx}.remove-photo::before{content:"";position:absolute;width:50rpx;height:50rpx;border-radius:50%;background:#433A38CC;z-index:-1}.photo-add{background:var(--color-bg);border:1rpx dashed #BBA596;border-radius:4rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--color-accent);font-size:24rpx}.photo-add text{font-size:42rpx;line-height:1.4}.photo-help{font-size:22rpx;margin-top:20rpx}
.compose-photos button.remove-photo{width:44px;height:44px;background:#433A38CC;border-radius:50%;z-index:1}.compose-photos button.remove-photo::before{display:none}.compose-photos button.photo-add{width:100%}

.compose-title{font-weight:400}.compose-body{font-size:var(--font-body);line-height:1.85}.compose-photos button.remove-photo{width:var(--touch-target);height:var(--touch-target)}
.compose-title{padding:0;height:104rpx;line-height:normal}
