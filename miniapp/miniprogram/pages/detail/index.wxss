.detail-paper{border-radius:2rpx;border-top:4rpx solid var(--color-pink)}.detail-title{font-family:"Songti SC","Noto Serif CJK SC",STSong,serif;font-size:42rpx;font-weight:600;line-height:1.6;margin-top:32rpx}.detail-images{display:grid;gap:24rpx;margin-top:32rpx}.detail-images image{width:100%;border-radius:2rpx;background:#EEE7DC}.comments{margin-top:20rpx;border:0;border-top:1rpx solid #D8C8BA;border-radius:0;padding:20rpx 0;background:transparent;box-shadow:none}.comment{padding:24rpx 0;border-bottom:1rpx solid var(--color-line)}.comment:first-child{padding-top:0}.comment:last-child{border:0;padding-bottom:0}.comment-body{font-size:28rpx;color:#61534E;margin-top:12rpx;line-height:1.9;white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere}.comment-empty{text-align:center;font-size:26rpx;color:var(--color-secondary);padding:24rpx 0}.comment-form{display:flex;gap:16rpx;align-items:center}.comment-form input{flex:1;min-width:0;background:var(--color-surface);border:1rpx solid #CCB8AA;padding:20rpx;border-radius:var(--radius-sm);font-size:28rpx;height:96rpx;min-height:44px}.comment-form button{background:var(--color-accent);color:var(--color-surface);border-radius:var(--radius-sm);padding:22rpx 26rpx;font-size:28rpx;min-height:44px;flex-shrink:0}
.comment-form button{width:auto}

.comment-body{font-size:var(--font-body);line-height:1.85}
.comment-form input{padding:0 20rpx;line-height:normal}
.comment-form button,.comment-form input{min-height:var(--touch-target)}
