.period-title{font-size:44rpx;margin:14rpx 0 24rpx}.period-caption{font-size:26rpx;color:var(--color-secondary);margin:16rpx 0 24rpx}.period-hero{border-radius:2rpx;border-top:4rpx solid var(--color-pink);padding:40rpx 32rpx}.period-date{font-size:56rpx;color:var(--color-accent);line-height:1.5;margin:12rpx 0;overflow-wrap:anywhere}.period-status{font-size:30rpx;margin-bottom:20rpx}.period-note{border-top:1rpx solid var(--color-line);padding-top:24rpx;margin-top:24rpx;font-size:24rpx;color:var(--color-secondary)}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:28rpx 0;border-bottom:1rpx solid var(--color-line)}.setting-row>view{flex:1;min-width:0}.setting-row switch{flex-shrink:0}.invite-link{margin:16rpx auto 0;width:100%!important;text-align:center;white-space:normal}.record{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx 0;border-bottom:1rpx solid var(--color-line)}.record:last-child{border:0}.records{margin-top:20rpx}.record-actions{display:flex;gap:16rpx;flex-shrink:0}.record-actions button{font-size:24rpx}.care-hint{margin-top:20rpx}.period-form{margin-top:20rpx}.period-form picker .field{height:auto;min-height:48px}.period-form>.title{margin-bottom:20rpx}@media(max-width:360px){.record{align-items:flex-start;flex-direction:column}.record-actions{align-self:flex-end}.period-date{font-size:50rpx}}
