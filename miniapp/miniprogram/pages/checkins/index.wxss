.history-screen{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.history-title{font-size:44rpx;line-height:1.5;margin:16rpx 0;overflow-wrap:anywhere}.month-picker{min-height:48px;padding:20rpx 24rpx;margin:32rpx 0 16rpx;background:var(--color-surface);border:1rpx solid var(--color-border-strong);border-radius:var(--radius-sm);flex-wrap:wrap}.month-action{font-size:24rpx;color:var(--color-accent)}.loaded-range{margin:16rpx 0 24rpx}.day-card{margin-top:24rpx}.day-heading{padding-bottom:20rpx;border-bottom:1rpx solid var(--color-line);flex-wrap:wrap}.day-date{font-size:32rpx}.member-record{padding-top:24rpx}.member-record+.member-record{margin-top:24rpx;border-top:1rpx solid var(--color-line)}.member-heading{align-items:flex-start;flex-wrap:wrap}.member-name{min-width:0;overflow-wrap:anywhere;flex:1}.member-mood{font-size:26rpx;color:var(--color-secondary)}.member-mood.checked{color:var(--color-accent)}.record-message{font-size:30rpx;line-height:1.85;color:var(--color-body);white-space:pre-wrap;overflow-wrap:anywhere;margin:16rpx 0}.missing-note{margin-top:12rpx}.load-more{margin-top:32rpx}
