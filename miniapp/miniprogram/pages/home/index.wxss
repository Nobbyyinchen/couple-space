.home-greeting{margin:8rpx 0 30rpx;align-items:flex-end}.home-greeting .title{font-size:34rpx;margin-top:12rpx}.home-greeting>.stack{padding-bottom:4rpx}.home-greeting .avatar{height:64rpx;width:64rpx;font-size:22rpx;white-space:nowrap}
.together-card{background:var(--color-surface);border-radius:8rpx 8rpx 44rpx 8rpx;border:1rpx solid #DDCBC4;color:var(--color-text);padding:32rpx 36rpx 26rpx;position:relative;overflow:hidden;box-shadow:var(--shadow-paper);border-top:6rpx solid var(--color-pink)}.together-top{position:relative;z-index:1}.together-names{font-size:28rpx;font-weight:500;max-width:75%;word-break:break-all}.name-separator{color:var(--color-secondary);font-size:24rpx;margin:0 12rpx}.together-edition{font-size:20rpx;letter-spacing:2rpx;color:var(--color-accent);flex-shrink:0}.together-label{font-size:26rpx;margin-top:30rpx;color:var(--color-secondary);position:relative;z-index:1}.together-counter{display:flex;align-items:baseline;gap:16rpx;position:relative;z-index:1;width:75%;word-break:break-all}.together-counter .counter{font-size:148rpx;line-height:1.25;letter-spacing:-4rpx;color:var(--color-accent)}.day-unit{font-size:28rpx;color:var(--color-secondary);flex-shrink:0}.bloom-stamp{position:absolute;right:22rpx;top:98rpx;width:155rpx;text-align:center;transform:rotate(7deg)}.bloom-stamp image{width:146rpx;height:170rpx}.bloom-stamp>text{display:block;font-size:22rpx;letter-spacing:3rpx;color:var(--color-secondary)}.together-foot{display:flex;justify-content:space-between;gap:12rpx;border-top:1rpx solid var(--color-line);padding-top:20rpx;margin-top:20rpx;font-size:22rpx;color:var(--color-secondary);position:relative;z-index:1}.together-foot text:last-child{color:var(--color-accent);flex-shrink:0}
.next-card{display:flex;align-items:center;gap:22rpx;width:100%;text-align:left;padding:24rpx 0;margin-top:8rpx;border-bottom:1rpx solid var(--color-line);min-height:120rpx}.calendar-icon{width:80rpx;flex-shrink:0;border:1rpx solid #D9B7BB;border-radius:6rpx;text-align:center;background:var(--color-surface);overflow:hidden}.calendar-icon text{display:block}.calendar-icon>text:first-child{background:#F2E1DF;color:var(--color-accent);font-size:22rpx;padding:2rpx 0}.calendar-icon .counter{font-size:38rpx;color:var(--color-text);line-height:1.35;padding:4rpx 0}.next-copy{flex:1;min-width:0}.next-copy .eyebrow{font-size:20rpx;letter-spacing:1rpx;color:var(--color-secondary)}.next-title{font-size:28rpx;font-weight:500;line-height:1.6;margin:3rpx 0;word-break:break-word}.next-copy .subtle{font-size:22rpx}.next-tail{display:flex;align-items:center;gap:14rpx;flex-shrink:0}.next-gap{font-size:24rpx;color:var(--color-accent);max-width:140rpx}.quick-actions{display:flex;margin-top:24rpx;padding-bottom:8rpx}.quick{flex:1;min-width:0;width:0;text-align:center;font-size:26rpx;font-weight:500;padding:16rpx 4rpx;border-right:1rpx solid var(--color-line)}.quick:last-child{border:0}.quick .tiny{font-weight:400;margin-top:6rpx;font-size:22rpx}.quick-icon{display:block;width:44rpx;height:44rpx;margin:0 auto 14rpx}
.section-heading .title{margin-top:8rpx}.section-heading .eyebrow{font-size:20rpx;letter-spacing:2rpx}.mood-card{margin-top:22rpx;border-radius:var(--radius-md)}.partner-message{font-size:28rpx;color:#61534E;margin-top:24rpx;line-height:1.9;border-left:3rpx solid var(--color-sage);padding-left:20rpx}.mood-input{font-size:26rpx;padding:22rpx 0 16rpx;border-bottom:1rpx solid #CCB9AE;height:96rpx;min-height:44px}.mood-submit{font-size:26rpx;color:var(--color-accent);padding:22rpx 0 0;min-height:44px;text-align:right;font-weight:500}.mood-submit text{margin-left:14rpx}.post-card{margin-top:24rpx;padding:30rpx 0;border-top:1rpx solid #D7C7BA}.demo-pill{margin-left:auto}.welcome{text-align:center;padding:56rpx 0}.welcome image{height:300rpx;width:260rpx}.welcome-title{font-size:38rpx;margin:28rpx 0 20rpx;line-height:1.6}.welcome .primary{margin-top:44rpx}.invite-prompt{padding:22rpx 0;border-top:1rpx solid var(--color-line);border-bottom:1rpx solid var(--color-line)}.paper-empty{background:var(--color-surface);margin-top:24rpx;border:1rpx dashed #D8C8BA}
.home-screen button.next-card{width:100%;padding-left:0;padding-right:0;font-weight:400}.quick-actions button.quick{width:0;padding-left:4rpx;padding-right:4rpx}.status-row button.status-button{width:auto}.screen button.mood-submit{width:100%;padding-left:0;padding-right:0}
@media(max-width:350px){.home-greeting .title{font-size:32rpx}.home-greeting .avatar{height:54rpx;width:54rpx;font-size:21rpx}.together-card{padding-left:28rpx;padding-right:28rpx}.together-counter .counter{font-size:138rpx}.next-card{gap:16rpx}.next-tail{gap:8rpx}.next-gap{font-size:23rpx}.quick{font-size:25rpx}}

.bloom-stamp{top:auto;bottom:92rpx}.together-counter.long-count .counter{font-size:96rpx;letter-spacing:-2rpx}.home-screen .mood-submit{font-weight:500}.home-screen button.status-button{min-width:var(--touch-target);padding-left:16rpx;padding-right:16rpx}.home-screen .status-row{gap:16rpx}
.mood-input{padding:0;line-height:normal}
.home-greeting{align-items:center;margin-bottom:20rpx;gap:24rpx}.home-greeting-copy{flex:1;min-width:0}.home-greeting .title{margin-top:0;font-size:40rpx;line-height:1.5}.home-greeting>.stack{flex-shrink:0}.home-tagline{font-size:23rpx;line-height:1.85;color:var(--color-accent);margin-top:10rpx;word-break:break-word}.home-introduction{font-size:26rpx;line-height:1.95;color:var(--color-secondary);padding-left:20rpx;border-left:3rpx solid var(--color-sage);margin:0 0 32rpx;word-break:break-word}.welcome-description{font-size:27rpx;line-height:1.95;color:var(--color-secondary);margin:24rpx 0 0}
