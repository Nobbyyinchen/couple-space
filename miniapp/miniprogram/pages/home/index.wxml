<view class="screen home-screen">
 <view wx:if="{{demo}}" class="mode-banner">本机演示 · 内容仅保存在当前设备，还未双人同步</view>
 <view wx:if="{{state.offline}}" class="mode-banner">当前显示手机缓存，联网后下拉刷新。</view>
 <view wx:if="{{error}}" class="error-box">{{error}}<button class="link" bindtap="refresh">重新加载</button></view>
 <view wx:if="{{loading}}" class="empty">正在打开我们的小宇宙…</view>
 <view wx:elif="{{!state.space}}" class="welcome"><image aria-hidden="true" src="/assets/paper-bloom.png" mode="aspectFit"/><view class="welcome-title editorial">{{brand.title}}</view><view class="subtle">{{brand.tagline}}</view><view class="welcome-description">{{brand.description}}</view><button class="primary" bindtap="pair">创建或加入我们的空间</button></view>
 <block wx:else>
  <view class="home-greeting between"><view class="home-greeting-copy"><view class="title editorial">{{brand.title}}</view><view class="home-tagline">{{brand.tagline}}</view></view><view class="stack"><view class="avatar">{{state.space.members[0].nickname}}</view><view wx:if="{{state.space.paired}}" class="avatar second">{{state.space.members[1].nickname}}</view></view></view>
  <view class="home-introduction">{{brand.description}}</view>
  <view class="together-card">
   <view class="together-top between"><text class="together-names">{{state.space.members[0].nickname}} <text class="name-separator">与</text> {{state.space.members[1].nickname || '等你加入'}}</text><text class="together-edition">OUR DAYS</text></view>
   <view class="together-label">{{future ? '距离我们的故事开始，还有' : '我们已经在一起'}}</view>
   <view class="together-counter {{days > 9999 ? 'long-count' : ''}}"><text class="counter">{{days}}</text><text class="day-unit">天</text></view>
   <view class="bloom-stamp"><image aria-hidden="true" src="/assets/paper-bloom.png" mode="aspectFit"/><text>一日，一页。</text></view>
   <view class="together-foot"><text>故事始于 {{state.space.startDate}}</text><text>未完待续</text></view>
  </view>
  <button wx:if="{{next}}" class="next-card" bindtap="us"><view class="calendar-icon"><text>{{next.month}} 月</text><text class="counter">{{next.day}}</text></view><view class="next-copy"><view class="eyebrow">下一个值得期待的日子</view><view class="next-title">{{next.title}}</view><view class="subtle">{{next.next}}</view></view><view class="next-tail"><text class="next-gap">{{next.gapLabel}}</text><text class="chevron">›</text></view></button>
  <view class="quick-actions"><button class="quick" bindtap="compose"><image aria-hidden="true" src="/assets/icon-pen.png" class="quick-icon"/><view>记下今天</view><view class="tiny muted">一个小瞬间</view></button><button class="quick" bindtap="wishes"><image aria-hidden="true" src="/assets/icon-wish.png" class="quick-icon"/><view>一起做的事</view><view class="tiny muted">一份小期待</view></button><button class="quick" bindtap="us"><image aria-hidden="true" src="/assets/icon-calendar.png" class="quick-icon"/><view>重要日子</view><view class="tiny muted">每一次纪念</view></button></view>
  <view wx:if="{{!state.space.paired}}" class="invite-prompt section between"><view><view class="small">这里，还在等另一半。</view><view class="tiny muted">分享邀请码，一起写下我们的故事。</view></view><button class="link" bindtap="pair">邀请 TA →</button></view>
  <view class="section between section-heading"><view><view class="eyebrow">DAILY NOTE</view><view class="title editorial">今天的我们</view></view><button class="link" bindtap="checkinHistory">打卡记录 →</button></view>
  <view class="card mood-card"><view class="between"><view class="row"><view class="avatar mini second">{{partner.nickname || 'TA'}}</view><view><view class="author-name">{{partner.nickname || '另一半'}}</view><view class="tiny muted">{{other ? '今天留下的小心情' : '等 TA 分享今天的近况'}}</view></view></view><text class="pill">{{other.mood || '还没打卡'}}</text></view><view class="partner-message">{{other.message || (other ? '今天也在好好生活。' : '等 TA 主动留下一句近况，慢慢分享就好。')}}</view><view class="divider"></view><view class="between"><view class="small">我今天的心情</view><text class="subtle">{{me ? '已打卡' : '未打卡'}}</text></view><view class="status-row"><button wx:for="{{moods}}" wx:key="*this" aria-label="{{selectedMood === item ? '已选中：' : '选择心情：'}}{{item}}" data-mood="{{item}}" bindtap="mood" class="status-button {{selectedMood === item ? 'selected' : ''}}"><text wx:if="{{selectedMood === item}}">✓</text>{{item}}</button></view><text class="field-label">给 TA 的一句近况</text><input aria-label="给另一半的一句近况" placeholder-style="color:#766962" class="mood-input" maxlength="200" value="{{message}}" bindinput="message" placeholder="再和 TA 说一句今天的近况…"/><button class="mood-submit" disabled="{{saving || state.offline}}" loading="{{saving}}" bindtap="checkIn">{{me ? '更新今天的心情' : '把心情告诉 TA'}} <text>↗</text></button></view>
  <view class="section between section-heading"><view><view class="eyebrow">COLLECTED MOMENTS</view><view class="title editorial">最近的小美好</view></view><button class="link" bindtap="memories">全部回忆 →</button></view>
  <view wx:if="{{!recent.length}}" class="empty paper-empty"><view class="empty-symbol"><image aria-hidden="true" src="/assets/icon-pen.png"/></view><view class="empty-title editorial">故事的第一页，留给你们。</view><view class="subtle">拍张照片，或者写一句今天想说的话。</view><button class="primary" bindtap="compose">记下第一个瞬间</button></view>
  <view wx:for="{{recent}}" wx:key="id" wx:for-item="entry" class="post-card"><view hover-class="story-hover" class="row" data-id="{{entry.id}}" bindtap="detail"><view class="avatar mini">{{entry.initial}}</view><view><view class="author-name">{{entry.authorName}}</view><view class="date-label">{{entry.date}} · {{entry.timeLabel}}</view></view><text wx:if="{{demo}}" class="pill demo-pill">示例</text></view><view hover-class="story-hover" data-id="{{entry.id}}" bindtap="detail"><view wx:if="{{entry.title}}" class="post-title">{{entry.title}}</view><view class="post-body">{{entry.body}}</view></view><view class="post-grid {{entry.images.length === 1 ? 'single' : ''}}"><image lazy-load="true" aria-label="回忆照片，第 {{index + 1}} 张" wx:for="{{entry.images}}" wx:key="id" src="{{item.url}}" mode="aspectFill" data-id="{{entry.id}}" data-url="{{item.url}}" bindtap="preview"/></view><view class="post-footer"><text>属于我们的日常</text><view class="post-reactions"><button class="post-action {{entry.liked ? 'liked' : ''}}" data-id="{{entry.id}}" aria-label="{{entry.liked ? '取消喜欢' : '喜欢这段回忆'}}，{{entry.likeCount}} 人喜欢" bindtap="like"><image class="action-icon" src="{{entry.liked ? '/assets/icon-heart-active.png' : '/assets/icon-heart.png'}}"/>{{entry.likeCount}}</button><button class="post-action" data-id="{{entry.id}}" bindtap="detail">留言 {{entry.commentCount}}</button></view></view></view>
  <view class="bottom-note">一颗小宇，一条小宙。故事还在继续。</view>
 </block>
</view>
