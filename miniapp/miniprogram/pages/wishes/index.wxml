<view class="screen"><view wx:if="{{state.demo}}" class="mode-banner">本机演示 · 试着点亮一个心愿</view><view wx:if="{{state.offline}}" class="mode-banner">正在查看手机缓存，修改心愿需要连接网络。</view>
 <view class="wish-hero"><view class="eyebrow">一起，把期待变成日常</view><view class="wish-hero-title editorial">和你，还有好多<text>想一起做的事。</text></view><view class="wish-progress between"><view><text class="counter">{{done}}</text><text> / {{wishes.length}} 个小心愿已实现</text></view><text class="progress-caption">慢慢来，一起走</text></view><view class="progress-track"><view class="progress-fill" style="transform:scaleX({{wishes.length ? done / wishes.length : 0}});"></view></view></view>
 <text class="field-label">再添一个小心愿</text><view class="add-wish"><input aria-label="想一起做的事" placeholder-style="color:#766962" value="{{text}}" bindinput="input" maxlength="100" placeholder="下一件想和 TA 做的事…" confirm-type="done" bindconfirm="add"/><button bindtap="add" disabled="{{saving || state.offline}}" loading="{{saving}}" aria-label="添加心愿">＋</button></view>
 <view class="wish-filters"><button class="wish-filter {{filter === 'pending' ? 'active' : ''}}" data-filter="pending" bindtap="filter">等待实现</button><button class="wish-filter {{filter === 'done' ? 'active' : ''}}" data-filter="done" bindtap="filter">已经实现</button><button class="wish-filter {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="filter">全部心愿</button></view>
 <view wx:if="{{error}}" class="error-box">{{error}}<button class="link" bindtap="refresh">重新加载</button></view><view wx:if="{{loading}}" class="empty">正在打开我们的心愿清单…</view>
 <view class="wish-list"><view wx:for="{{visible}}" wx:key="id" class="wish-card {{item.done ? 'completed' : ''}}"><button class="wish-check" data-id="{{item.id}}" bindtap="toggle" disabled="{{updating || state.offline}}" aria-label="{{item.done ? '将心愿标记为未完成' : '将心愿标记为已完成'}}"><text>{{item.done ? '✓' : ''}}</text></button><view class="wish-copy"><view>{{item.text}}</view><view class="subtle">{{item.done ? '已实现 · 又多了一段共同回忆' : '待实现 · 留给未来的我们'}}</view></view></view></view>
 <view wx:if="{{!loading && !visible.length}}" class="empty"><view class="empty-symbol"><image aria-hidden="true" src="/assets/icon-wish.png"/></view><view class="empty-title editorial">{{filter === 'done' ? '美好的事，正在路上。' : '写下一个想一起做的小心愿。'}}</view><view class="subtle">一起散步、看海、做饭，小事也很珍贵。</view></view><view class="bottom-note">一件一件，慢慢实现。</view>
</view>
