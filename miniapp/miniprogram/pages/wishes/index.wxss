.wish-hero{padding:12rpx 0 32rpx}.wish-hero-title{font-size:48rpx;line-height:1.5;margin:22rpx 0 28rpx}.wish-hero-title text{display:block;color:var(--color-accent)}.wish-progress{font-size:24rpx;color:var(--color-secondary)}.wish-progress .counter{font-size:46rpx;color:var(--color-accent);margin-right:4rpx}.progress-caption{font-size:22rpx}.progress-track{height:6rpx;background:#EAE4DB;margin-top:16rpx;border-radius:4rpx;overflow:hidden}.progress-fill{height:100%;background:var(--color-sage);transition:width .2s ease}.add-wish{display:flex;align-items:center;gap:16rpx;padding:18rpx 20rpx;background:var(--color-surface);border:1rpx solid #D2B8BA;border-radius:var(--radius-sm)}.add-wish input{flex:1;min-width:0;font-size:28rpx;height:88rpx;min-height:44px}.add-wish button{border-radius:10rpx;width:44px;height:44px;line-height:44px;flex-shrink:0;background:var(--color-accent);color:var(--color-surface);font-size:36rpx}.wish-filters{display:flex;gap:0;border-bottom:1rpx solid var(--color-line);margin-top:24rpx}.wish-filter{flex:1;min-width:0;font-size:26rpx;color:var(--color-secondary);padding:24rpx 8rpx;min-height:44px;border-bottom:3rpx solid transparent}.wish-filter.active{color:var(--color-accent);border-bottom-color:var(--color-accent);font-weight:500}.wish-list{margin-top:12rpx}.wish-card{display:flex;align-items:center;gap:14rpx;padding:24rpx 0;border-bottom:1rpx solid var(--color-line)}.wish-check{width:44px;height:44px;flex-shrink:0;display:flex;align-items:center;justify-content:center}.wish-check text{width:40rpx;height:40rpx;border:2rpx solid #A88C82;border-radius:6rpx;display:flex;align-items:center;justify-content:center;color:var(--color-surface);font-size:28rpx}.completed .wish-check text{background:var(--color-success);border-color:var(--color-success)}.wish-copy{flex:1;min-width:0;font-size:29rpx;word-break:break-word;overflow-wrap:anywhere}.wish-copy .subtle{font-size:22rpx;margin-top:8rpx}.completed .wish-copy>view:first-child{text-decoration:line-through;color:var(--color-secondary)}.completed .wish-copy .subtle{color:var(--color-success)}
.add-wish button{width:44px}.wish-list button.wish-check{width:44px}.wish-filters button.wish-filter{width:0}

.progress-fill{width:100%;transform-origin:left center;transition:transform var(--motion-progress) ease}.wish-filters{gap:16rpx}.add-wish button,.wish-list button.wish-check{width:var(--touch-target);height:var(--touch-target)}.wish-card{gap:16rpx}
