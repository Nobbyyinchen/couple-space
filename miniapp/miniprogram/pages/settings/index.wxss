.settings-intro{margin:8rpx 0 28rpx}.settings-intro .title{font-size:40rpx;margin-top:12rpx}.profile-paper{border-radius:2rpx;border-top:4rpx solid var(--color-pink)}.anniversary-form{margin-top:24rpx;border-radius:var(--radius-sm);box-shadow:none}.date-picker{margin:24rpx 0;display:flex;align-items:center;justify-content:space-between;color:var(--color-accent)}.date-picker text{color:var(--color-secondary)}.anniversary-form switch{transform:scale(.9);transform-origin:left center;margin-right:-6rpx}.anniversary-form .link{padding-left:16rpx;padding-right:8rpx}
