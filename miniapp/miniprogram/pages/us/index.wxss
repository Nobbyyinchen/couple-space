.us-hero{text-align:center;padding:28rpx 0 36rpx}.couple-avatars{display:flex;align-items:center;justify-content:center;gap:24rpx}.us-avatar{width:120rpx;height:120rpx;border:6rpx solid var(--color-surface);border-radius:50%;background:#F0DDDA;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:#79505A;box-shadow:0 0 0 1rpx #DABFBA;overflow:hidden}.us-avatar.partner{background:#E5EADF;color:var(--color-success);box-shadow:0 0 0 1rpx #BBC5B5}.couple-avatars>text{color:var(--color-accent);font-family:Georgia,serif;font-style:italic;font-size:34rpx}.us-name{font-size:42rpx;font-weight:600;margin:28rpx 0 12rpx;font-family:"Songti SC","Noto Serif CJK SC",STSong,serif;word-break:break-word}.us-tag{display:inline-block;border-bottom:1rpx solid #C9B4A5;color:var(--color-secondary);font-size:22rpx;padding:8rpx 0;margin-top:18rpx}.stats{display:flex;text-align:center;padding:28rpx 0;border-radius:0;background:transparent;border:0;border-top:1rpx solid #D8C8BA;border-bottom:1rpx solid #D8C8BA;box-shadow:none}.stats>view{flex:1;min-width:0;border-right:1rpx solid var(--color-line)}.stats>view:last-child{border:0}.stats text{display:block}.stats .counter{font-size:48rpx;color:var(--color-accent);line-height:1.4}.stats text:last-child{font-size:22rpx;color:var(--color-secondary);margin-top:8rpx}.dates-card{margin-top:20rpx;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none}.anniversary{display:flex;align-items:center;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid var(--color-line)}.date-dot{width:40rpx;height:40rpx;flex-shrink:0}.anniversary-name{flex:1;min-width:0;font-size:28rpx}.anniversary-name .subtle{font-size:24rpx;margin-top:4rpx}.gap{font-size:25rpx;color:var(--color-accent);flex-shrink:0}.menu{padding:4rpx 28rpx;background:var(--color-surface);border-radius:var(--radius-sm)}
.menu button.menu-item{width:100%}
.us-tagline{color:var(--color-accent);line-height:1.85;font-size:24rpx}.us-description{max-width:620rpx;margin:20rpx auto;font-size:26rpx;line-height:1.95;color:var(--color-secondary);word-break:break-word}
