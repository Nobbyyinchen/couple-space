<view class="screen"><view wx:if="{{state.demo}}" class="mode-banner">本机演示 · 当前身份：{{state.actor.nickname}}</view><view wx:if="{{error}}" class="error-box">{{error}}</view><view wx:if="{{loading}}" class="empty">正在打开我们的空间…</view><block wx:if="{{state.space}}"><view class="us-hero"><view class="couple-avatars"><view class="us-avatar">{{state.space.members[0].nickname}}</view><text>与</text><view class="us-avatar partner">{{state.space.members[1].nickname || '等你'}}</view></view><view class="us-name">{{state.space.name}}</view><view class="subtle us-tagline">{{brand.tagline}}</view><view class="us-description">{{brand.description}}</view><view class="subtle">故事始于 {{state.space.startDate}}</view><view class="us-tag">{{state.demo ? '演示双人空间' : (state.space.paired ? '两个人 · 一个小宇宙' : '等待另一半加入')}}</view></view><view class="card stats"><view><text class="counter">{{state.days}}</text><text>相伴天数</text></view><view><text class="counter">{{state.entries.length}}</text><text>最近加载手记</text></view><view><text class="counter">{{done}}</text><text>已完成心愿</text></view></view>
<view class="section between"><view class="title editorial">值得期待的日子</view><button class="link" bindtap="settings">管理 →</button></view><view class="card dates-card section"><view wx:for="{{state.anniversaries}}" wx:key="id" class="anniversary"><image aria-hidden="true" class="date-dot" src="/assets/icon-calendar.png"/><view class="anniversary-name"><view>{{item.title}}</view><view class="subtle">{{item.next}}</view></view><text class="gap">{{item.gapLabel}}</text></view></view>
<view class="card section menu"><button class="menu-item" bindtap="period"><image aria-hidden="true" class="menu-icon" src="/assets/icon-calendar.png"/><text class="menu-copy">把你放在心上 · 生理期记录</text><text class="chevron">›</text></button><button class="menu-item" bindtap="notifications"><image aria-hidden="true" class="menu-icon" src="/assets/icon-info.png"/><text class="menu-copy">我们的消息与提醒</text><text class="chevron">›</text></button><button class="menu-item" bindtap="settings"><image aria-hidden="true" class="menu-icon" src="/assets/icon-settings.png"/><text class="menu-copy">资料和纪念日</text><text class="chevron">›</text></button><button wx:if="{{!state.space.paired}}" class="menu-item" bindtap="pair"><image aria-hidden="true" class="menu-icon" src="/assets/icon-heart.png"/><text class="menu-copy">邀请另一半加入</text><text class="chevron">›</text></button><button class="menu-item" bindtap="about"><image aria-hidden="true" class="menu-icon" src="/assets/icon-info.png"/><text class="menu-copy">关于{{brand.title}}</text><text class="chevron">›</text></button><button wx:if="{{!state.demo}}" class="menu-item" bindtap="clearCache"><image aria-hidden="true" class="menu-icon" src="/assets/icon-refresh.png"/><text class="menu-copy">清除本机页面缓存</text><text class="chevron">›</text></button><button wx:if="{{state.demo}}" class="menu-item" bindtap="switchActor"><image aria-hidden="true" class="menu-icon" src="/assets/icon-swap.png"/><text class="menu-copy">切换演示身份：{{state.actor.id === 'demo-partner-a' ? names[1] : names[0]}}</text><text class="chevron">›</text></button><button wx:if="{{state.demo}}" class="menu-item" bindtap="setup"><image aria-hidden="true" class="menu-icon" src="/assets/icon-cloud.png"/><text class="menu-copy">如何启用双人同步</text><text class="chevron">›</text></button><button wx:if="{{state.demo}}" class="menu-item" bindtap="resetDemo"><image aria-hidden="true" class="menu-icon" src="/assets/icon-refresh.png"/><text class="menu-copy muted">重置本机演示</text><text class="chevron">›</text></button></view><view class="bottom-note">{{brand.title}} · 故事还在继续</view></block><view wx:elif="{{!loading}}" class="card empty"><view class="empty-symbol"><image aria-hidden="true" src="/assets/icon-heart.png"/></view><view class="empty-title">先把两个人，放进同一个空间。</view><button class="primary" bindtap="pair">创建或加入我们的空间</button></view></view>
