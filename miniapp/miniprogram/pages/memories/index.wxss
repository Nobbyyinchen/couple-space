.feed-head{padding:10rpx 0 28rpx;border-bottom:1rpx solid #D9C9BC}.feed-title{font-size:48rpx;line-height:1.5;margin:22rpx 0}.feed-title text{display:block;color:var(--color-accent)}.feed-tools{margin:16rpx 0}.feed-tabs{display:flex;gap:24rpx}.feed-tab{font-size:26rpx;color:var(--color-secondary);padding:20rpx 0 16rpx;min-height:44px;border-bottom:3rpx solid transparent}.feed-tab.active{color:var(--color-accent);border-bottom-color:var(--color-accent);font-weight:500}.loaded-count{font-size:22rpx;color:var(--color-secondary);flex-shrink:0}.search-box{display:flex;align-items:center;gap:16rpx;border-bottom:1rpx solid #CDBCAF;padding:0 4rpx;margin-bottom:36rpx}.search-box>image{height:32rpx;width:32rpx}.search{flex:1;min-width:0;border:0;font-size:26rpx;height:92rpx;min-height:44px}.feed-post{margin:0 0 32rpx 8rpx;border-left:1rpx solid #DCC9C3;padding-left:28rpx}.timeline-date{position:relative;display:flex;align-items:center;gap:14rpx;font-size:25rpx;color:var(--color-accent);padding-bottom:20rpx;letter-spacing:1rpx}.timeline-dot{position:absolute;left:-36rpx;width:14rpx;height:14rpx;border-radius:50%;background:var(--color-pink);box-shadow:0 0 0 6rpx var(--color-bg)}.timeline-number{margin-left:auto;color:var(--color-secondary);font-size:21rpx;letter-spacing:2rpx}.story-paper{background:var(--color-surface);border:1rpx solid var(--color-line);padding:28rpx;border-radius:2rpx;box-shadow:var(--shadow-paper)}.story-paper .post-title{font-size:34rpx}.story-paper .post-body{font-size:28rpx}.photo-story .story-paper{padding:20rpx}.photo-story .post-grid{padding:8rpx;background:#F4EEE5;border:1rpx solid var(--color-line)}.photo-story .post-grid image{border-radius:0}.photo-story .post-grid.single image{height:410rpx}.feed-empty{border-top:1rpx dashed #D8C8BA;margin-top:36rpx}@media(max-width:350px){.feed-title{font-size:46rpx}.feed-tabs{gap:20rpx}.story-paper{padding:24rpx}.feed-post{padding-left:24rpx}.timeline-dot{left:-32rpx}}
.feed-tabs button.feed-tab{width:auto}

.search-label{margin-top:20rpx;margin-bottom:0}.feed-tabs{gap:16rpx}.feed-tabs button{padding-left:8rpx;padding-right:8rpx}.screen .fixed-bottom{padding-bottom:20rpx}.feed-head .feed-title{font-size:var(--font-display)}
